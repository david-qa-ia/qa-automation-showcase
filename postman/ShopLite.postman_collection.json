        {
          "name": "Create order with coupon → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const order = pm.response.json();",
                  "const price = Number(pm.collectionVariables.get('productPrice'));",
                  "pm.test('totals are calculated server-side with 10% off', () => {",
                  "  const subtotal = price * 2;",
                  "  const discount = Math.round(subtotal * 0.10);",
                  "  pm.expect(order.subtotalCents).to.eql(subtotal);",
                  "  pm.expect(order.discountCents).to.eql(discount);",
                  "  pm.expect(order.totalCents).to.eql(subtotal - discount);",
                  "});",
                  "pm.test('status is CREATED and coupon is normalised', () => {",
                  "  pm.expect(order.status).to.eql('CREATED');",
                  "  pm.expect(order.couponCode).to.eql('WELCOME10');",
                  "});",
                  "pm.collectionVariables.set('orderId', order.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
