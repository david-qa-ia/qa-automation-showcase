        {
          "name": "Get product by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const productSchema = {",
                  "  type: 'object',",
                  "  required: ['id', 'sku', 'name', 'category', 'priceCents', 'stock', 'inStock'],",
                  "  additionalProperties: false,",
                  "  properties: {",
                  "    id: { type: 'integer', minimum: 1 },",
