                  "pm.test('explains how many units are left', () => {",
                  "  pm.expect(err.code).to.eql('INSUFFICIENT_STOCK');",
                  "  pm.expect(err.details.available).to.eql(Number(pm.collectionVariables.get('scarceStock')));",
                  "});"
                ]
