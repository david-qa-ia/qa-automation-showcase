    {
      "name": "02 Catalog",
      "item": [
        {
          "name": "List products (contract)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const productSchema = {",
                  "  type: 'object',",
                  "  required: ['id', 'sku', 'name', 'category', 'priceCents', 'stock', 'inStock'],",
                  "  additionalProperties: false,",
                  "  properties: {",
                  "    id: { type: 'integer', minimum: 1 },",
                  "    sku: { type: 'string' },",
                  "    name: { type: 'string', minLength: 1 },",
                  "    category: { type: 'string' },",
                  "    priceCents: { type: 'integer', minimum: 1 },",
                  "    stock: { type: 'integer', minimum: 0 },",
                  "    inStock: { type: 'boolean' }",
                  "  }",
                  "};",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('matches the list contract', () => {",
                  "  pm.response.to.have.jsonSchema({",
                  "    type: 'object',",
                  "    required: ['items', 'page', 'limit', 'total'],",
                  "    properties: { items: { type: 'array', items: productSchema } }",
                  "  });",
                  "});",
                  "const items = pm.response.json().items;",
                  "pm.test('inStock is consistent with stock', () => {",
                  "  items.forEach(p => pm.expect(p.inStock).to.eql(p.stock > 0));",
                  "});",
                  "// Pick test data dynamically instead of hard-coding ids.",
                  "const buyable = items.find(p => p.stock >= 3);",
                  "const scarce = items.find(p => p.stock > 0 && p.stock < 20);",
                  "pm.collectionVariables.set('productId', buyable.id);",
                  "pm.collectionVariables.set('productPrice', buyable.priceCents);",
                  "pm.collectionVariables.set('scarceProductId', scarce.id);",
                  "pm.collectionVariables.set('scarceStock', scarce.stock);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
